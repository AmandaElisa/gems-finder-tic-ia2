# Copie este arquivo para .streamlit/secrets.toml e preencha com os valores
# do seu app em https://developer.spotify.com/dashboard (Settings).
# O secrets.toml está no .gitignore — NUNCA commite as credenciais.
#
# No dashboard, cadastre exatamente este Redirect URI:
#   http://127.0.0.1:8501
# (o Spotify não aceita mais "localhost" em apps novos; use o IP de loopback
#  e acesse o app por http://127.0.0.1:8501, não por localhost)
#
# Sem este arquivo o app roda no modo SIMULADO, como no protótipo.

[spotify]
client_id = "SEU_CLIENT_ID"
client_secret = "SEU_CLIENT_SECRET"
redirect_uri = "http://127.0.0.1:8501"
